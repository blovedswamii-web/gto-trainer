# Python
__pycache__/
*.pyc
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
# Data written at runtime
backend/data/trainer.db
backend/data/trainer.db-*
backend/data/solutions/*.tmp
# Node
node_modules/
frontend/dist/
# OS
.DS_Store

# Full per-node strategies for exploit mode (~17 MB); regenerate with `make precompute`
backend/data/solutions/*.strategy.npz

# Postflop solutions are large (tens of MB per spot); `make precompute` builds them
backend/data/solutions/*
!backend/data/solutions/.gitkeep
